#!/usr/bin/env python3
"""Install and run Codex automation MCP servers from this repo."""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[1]
MANIFEST_PATH = REPO_ROOT / "codex-automation.json"
CODEX_CONFIG = Path.home() / ".codex" / "config.toml"
DEFAULT_USER_BIN = Path.home() / ".local" / "bin"
DEFAULT_CODEX_BINARY = Path("/Applications/Codex.app/Contents/Resources/codex")
DEFAULT_AWS_BINARIES = (
    Path("/usr/local/bin/aws"),
    Path("/opt/homebrew/bin/aws"),
)
IMESSAGE_AGENT_SOURCE = REPO_ROOT / "com.brianthomas.imessage-codex-agent.plist"
IMESSAGE_AGENT_DESTINATION = (
    Path.home() / "Library" / "LaunchAgents" / "com.brianthomas.imessage-codex-agent.plist"
)
IMESSAGE_AGENT_LABEL = "com.brianthomas.imessage-codex-agent"
IMESSAGE_AGENT_LOG = Path.home() / "Library" / "Logs" / "imessage-codex-agent.log"
IMESSAGE_AGENT_APP = Path.home() / "Applications" / "Codex iMessage Agent.app"
IMESSAGE_AGENT_APP_EXECUTABLE = IMESSAGE_AGENT_APP / "Contents" / "MacOS" / "Codex iMessage Agent"
IMESSAGE_AGENT_APP_INFO = IMESSAGE_AGENT_APP / "Contents" / "Info.plist"


def load_manifest() -> dict[str, Any]:
    try:
        return json.loads(MANIFEST_PATH.read_text())
    except FileNotFoundError:
        fail(f"Missing manifest: {MANIFEST_PATH}")
    except json.JSONDecodeError as exc:
        fail(f"Invalid JSON in {MANIFEST_PATH}: {exc}")


def fail(message: str, code: int = 1) -> None:
    print(f"cx: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(command: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=check, capture_output=True, text=True)


def command_path(command: str) -> str | None:
    path = shutil.which(command)
    if path:
        return path

    if command == "codex":
        app_path = Path("/Applications/Codex.app/Contents/Resources/codex")
        if app_path.exists():
            return str(app_path)

    if command == "aws":
        for candidate in DEFAULT_AWS_BINARIES:
            if candidate.exists():
                return str(candidate)

    return None


def launchctl_getenv(key: str) -> str | None:
    completed = subprocess.run(
        ["launchctl", "getenv", key],
        check=False,
        capture_output=True,
        text=True,
    )
    value = completed.stdout.strip()
    return value or None


def launchctl_print_service(label: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["launchctl", "print", f"gui/{os.getuid()}/{label}"],
        check=False,
        capture_output=True,
        text=True,
    )


def parse_launchctl_fields(output: str) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in output.splitlines():
        stripped = line.strip()
        for key in ("state", "pid", "last exit code"):
            prefix = f"{key} = "
            if stripped.startswith(prefix):
                fields[key] = stripped[len(prefix) :]
    return fields


def imessage_agent_status() -> tuple[str, dict[str, str], str]:
    completed = launchctl_print_service(IMESSAGE_AGENT_LABEL)
    plist_missing = not IMESSAGE_AGENT_DESTINATION.exists()
    if completed.returncode != 0:
        if plist_missing:
            return "missing", {}, f"LaunchAgent plist is not installed at {IMESSAGE_AGENT_DESTINATION}"
        detail = (completed.stderr or completed.stdout or "").strip()
        return "not loaded", {}, detail or "launchctl could not find the service"

    fields = parse_launchctl_fields(completed.stdout)
    state = fields.get("state", "unknown")
    detail = f"LaunchAgent plist is not installed at {IMESSAGE_AGENT_DESTINATION}" if plist_missing else ""
    return state, fields, detail


def print_imessage_agent_status() -> None:
    status, fields, detail = imessage_agent_status()
    print(f"imessage agent: {status}")
    print(f"imessage agent plist: {IMESSAGE_AGENT_DESTINATION}")
    print(f"imessage agent app: {IMESSAGE_AGENT_APP}")
    print(f"imessage agent full disk access target: {IMESSAGE_AGENT_APP}")
    print(f"imessage agent log: {IMESSAGE_AGENT_LOG}")
    if fields.get("pid"):
        print(f"imessage agent pid: {fields['pid']}")
    if fields.get("last exit code"):
        print(f"imessage agent last exit code: {fields['last exit code']}")
    if detail:
        print(f"imessage agent detail: {detail}")


def path_arg(value: str) -> Path:
    return Path(value).expanduser()


def parse_env_list(key: str) -> list[str]:
    value = os.environ.get(key, "")
    return [item.strip() for item in value.split(",") if item.strip()]


def read_secret(manifest: dict[str, Any]) -> dict[str, str]:
    secret_name = manifest.get("secretName", "automation")
    aws_path = command_path("aws")
    if not aws_path:
        fail("aws CLI not found; cannot read automation secrets.", 127)

    command = [
        aws_path,
        "secretsmanager",
        "get-secret-value",
        "--secret-id",
        secret_name,
        "--query",
        "SecretString",
        "--output",
        "text",
    ]
    try:
        completed = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except FileNotFoundError:
        fail("aws CLI not found; cannot read automation secrets.", 127)
    except subprocess.TimeoutExpired:
        fail("Timed out reading automation secrets from AWS Secrets Manager.")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        message = f"Failed to read AWS Secrets Manager secret '{secret_name}'."
        if detail:
            message = f"{message} {detail}"
        fail(message, exc.returncode or 1)

    try:
        parsed = json.loads(completed.stdout)
    except json.JSONDecodeError:
        fail(f"Secret '{secret_name}' must be a JSON object.")

    if not isinstance(parsed, dict):
        fail(f"Secret '{secret_name}' must be a JSON object.")

    return {key: value for key, value in parsed.items() if isinstance(value, str)}


def backup_config() -> None:
    if not CODEX_CONFIG.exists():
        return
    stamp = datetime.now().strftime("%Y%m%d%H%M%S")
    backup = CODEX_CONFIG.with_name(f"{CODEX_CONFIG.name}.bak-{stamp}")
    shutil.copy2(CODEX_CONFIG, backup)
    print(f"Backed up {CODEX_CONFIG} to {backup}")


def toml_quote(value: str) -> str:
    return json.dumps(value)


def toml_array(values: list[str]) -> str:
    return "[" + ", ".join(toml_quote(value) for value in values) + "]"


def server_section(name: str, spec: dict[str, Any]) -> str:
    lines = [f"[mcp_servers.{name}]"]
    approval = spec.get("defaultToolsApprovalMode")
    if approval:
        lines.append(f"default_tools_approval_mode = {toml_quote(str(approval))}")

    if spec.get("type") == "http":
        lines.append(f"url = {toml_quote(str(spec['url']))}")
        bearer = spec.get("bearerTokenEnvVar")
        if bearer:
            lines.append(f"bearer_token_env_var = {toml_quote(str(bearer))}")
    elif spec.get("type") == "stdio":
        command = str(spec["command"])
        args = [str(resolve_arg(arg)) for arg in spec.get("args", [])]
        lines.append(f"command = {toml_quote(command)}")
        lines.append(f"args = {toml_array(args)}")
    else:
        fail(f"Unsupported MCP server type for {name}: {spec.get('type')}")

    for tool_name, mode in sorted((spec.get("toolApprovals") or {}).items()):
        lines.append("")
        lines.append(f"[mcp_servers.{name}.tools.{tool_name}]")
        lines.append(f"approval_mode = {toml_quote(str(mode))}")

    return "\n".join(lines) + "\n"


def resolve_arg(arg: str) -> Path | str:
    path = REPO_ROOT / arg
    return path if path.exists() else arg


def replace_section(config: str, name: str, section: str) -> str:
    pattern = re.compile(
        rf"(?ms)^\[mcp_servers\.{re.escape(name)}\]\n.*?(?=^\[(?!mcp_servers\.{re.escape(name)}\.tools\.)|\Z)"
    )
    if pattern.search(config):
        return pattern.sub(section + "\n", config).rstrip() + "\n"
    if config and not config.endswith("\n"):
        config += "\n"
    return config + "\n" + section


def install_config(manifest: dict[str, Any], only: set[str] | None) -> None:
    CODEX_CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    config = CODEX_CONFIG.read_text() if CODEX_CONFIG.exists() else ""

    servers = manifest.get("mcpServers") or {}
    selected = only or set(servers)
    unknown = selected.difference(servers)
    if unknown:
        fail(f"Unknown MCP server(s): {', '.join(sorted(unknown))}")

    backup_config()
    for name in sorted(selected):
        config = replace_section(config, name, server_section(name, servers[name]))
        print(f"Configured MCP server: {name}")

    CODEX_CONFIG.write_text(config)


def install_launch_agent(manifest: dict[str, Any], bootstrap: bool) -> None:
    launch = manifest.get("launchAgent")
    if not launch:
        return

    source = REPO_ROOT / launch["source"]
    destination = Path(launch["destination"]).expanduser()
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)

    with source.open("rb") as source_file:
        plist = plistlib.load(source_file)
    plist["ProgramArguments"] = [str(REPO_ROOT / "bin" / "load-automation-env")]
    with destination.open("wb") as destination_file:
        plistlib.dump(plist, destination_file)
    print(f"Installed LaunchAgent: {destination}")

    if not bootstrap:
        return

    uid = str(os.getuid())
    label = str(launch["label"])
    run(["launchctl", "bootout", f"gui/{uid}", str(destination)], check=False)
    run(["launchctl", "bootstrap", f"gui/{uid}", str(destination)])
    run(["launchctl", "kickstart", "-k", f"gui/{uid}/{label}"])
    print(f"Started LaunchAgent: {label}")


def install_cx_on_path(bin_dir: Path) -> None:
    bin_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
    target = bin_dir / "cx"
    source = REPO_ROOT / "bin" / "cx"
    if target.exists() or target.is_symlink():
        if target.resolve() == source.resolve():
            print(f"cx already installed: {target}")
            return
        backup_existing_path(target)
    target.symlink_to(source)
    print(f"Installed cx: {target} -> {source}")


def backup_existing_path(path: Path) -> None:
    stamp = datetime.now().strftime("%Y%m%d%H%M%S")
    backup = path.with_name(f"{path.name}.bak-{stamp}")
    path.rename(backup)
    print(f"Backed up {path} to {backup}")


def find_real_codex() -> Path:
    override = os.environ.get("CX_REAL_CODEX")
    if override:
        return Path(override).expanduser()
    if DEFAULT_CODEX_BINARY.exists():
        return DEFAULT_CODEX_BINARY

    found = shutil.which("codex")
    if found:
        return Path(found)
    fail("Could not find Codex. Install Codex first or set CX_REAL_CODEX.")


def install_codex_wrapper(bin_dir: Path) -> None:
    bin_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
    real_codex = find_real_codex()
    if not real_codex.exists():
        fail(f"Real Codex binary does not exist: {real_codex}")

    wrapper = bin_dir / "codex"
    wrapper_text = f"""#!/bin/zsh
# Generated by cx. Loads automation secrets before running Codex.
export CX_REAL_CODEX={toml_quote(str(real_codex))}
exec {toml_quote(str(REPO_ROOT / "bin" / "cx"))} exec "$@"
"""
    if wrapper.exists() or wrapper.is_symlink():
        existing = wrapper.read_text(errors="ignore") if wrapper.is_file() and not wrapper.is_symlink() else ""
        if "Generated by cx" not in existing:
            backup_existing_path(wrapper)
        else:
            wrapper.unlink()

    wrapper.write_text(wrapper_text)
    wrapper.chmod(0o755)
    print(f"Installed codex wrapper: {wrapper}")
    print(f"Wrapper target: {real_codex}")


def install_imessage_agent_app() -> None:
    IMESSAGE_AGENT_APP_EXECUTABLE.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    IMESSAGE_AGENT_APP_INFO.parent.mkdir(mode=0o755, parents=True, exist_ok=True)

    wrapper_text = f"""#!/bin/zsh
# Generated by cx. Runs the iMessage-to-Codex agent from a selectable app bundle.
exec {toml_quote(sys.executable)} {toml_quote(str(REPO_ROOT / "bin" / "imessage-codex-agent"))} "$@"
"""
    IMESSAGE_AGENT_APP_EXECUTABLE.write_text(wrapper_text)
    IMESSAGE_AGENT_APP_EXECUTABLE.chmod(0o755)

    info = {
        "CFBundleDisplayName": "Codex iMessage Agent",
        "CFBundleExecutable": "Codex iMessage Agent",
        "CFBundleIdentifier": "com.brianthomas.imessage-codex-agent",
        "CFBundleName": "Codex iMessage Agent",
        "CFBundlePackageType": "APPL",
        "CFBundleShortVersionString": "1.0",
        "CFBundleVersion": "1",
        "LSBackgroundOnly": True,
    }
    with IMESSAGE_AGENT_APP_INFO.open("wb") as info_file:
        plistlib.dump(info, info_file)
    print(f"Installed iMessage Codex app wrapper: {IMESSAGE_AGENT_APP}")
    print(f"Grant Full Disk Access to: {IMESSAGE_AGENT_APP}")


def install_imessage_agent(args: argparse.Namespace) -> None:
    if not args.allowed_handles:
        fail("Pass --allowed-handle at least once, or set IMESSAGE_CODEX_ALLOWED_HANDLES.")
    if args.poll_seconds < 1:
        fail("--poll-seconds must be at least 1.")

    install_imessage_agent_app()
    IMESSAGE_AGENT_DESTINATION.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with IMESSAGE_AGENT_SOURCE.open("rb") as source_file:
        plist = plistlib.load(source_file)

    env = dict(plist.get("EnvironmentVariables") or {})
    env["IMESSAGE_CODEX_ALLOWED_HANDLES"] = ",".join(args.allowed_handles)
    env["IMESSAGE_CODEX_PREFIX"] = args.prefix
    env["IMESSAGE_CODEX_WORKDIR"] = str(args.workdir)
    env["IMESSAGE_CODEX_POLL_SECONDS"] = str(args.poll_seconds)
    env["IMESSAGE_CODEX_REPLY_MODE"] = args.reply_mode
    plist["EnvironmentVariables"] = env
    plist["ProgramArguments"] = [str(IMESSAGE_AGENT_APP_EXECUTABLE)]

    with IMESSAGE_AGENT_DESTINATION.open("wb") as destination_file:
        plistlib.dump(plist, destination_file)
    print(f"Installed iMessage Codex LaunchAgent: {IMESSAGE_AGENT_DESTINATION}")

    if args.no_bootstrap:
        return

    uid = str(os.getuid())
    run(["launchctl", "bootout", f"gui/{uid}", str(IMESSAGE_AGENT_DESTINATION)], check=False)
    run(["launchctl", "bootstrap", f"gui/{uid}", str(IMESSAGE_AGENT_DESTINATION)])
    run(["launchctl", "kickstart", "-k", f"gui/{uid}/{IMESSAGE_AGENT_LABEL}"])
    print(f"Started LaunchAgent: {IMESSAGE_AGENT_LABEL}")


def command_install_imessage_agent(args: argparse.Namespace) -> None:
    install_imessage_agent(args)


def command_imessage_agent_status(_: argparse.Namespace) -> None:
    print_imessage_agent_status()


def command_install(args: argparse.Namespace) -> None:
    manifest = load_manifest()
    selected = set(args.servers) if args.servers else None
    install_config(manifest, selected)
    if args.launch_agent and (selected is None or "home-assistant" in selected):
        install_launch_agent(manifest, bootstrap=not args.no_bootstrap)
    if args.install_cx:
        install_cx_on_path(args.bin_dir)
    if args.install_codex_wrapper:
        install_cx_on_path(args.bin_dir)
        install_codex_wrapper(args.bin_dir)
    if args.install_imessage_agent:
        install_imessage_agent(args)


def command_exec(args: argparse.Namespace) -> None:
    manifest = load_manifest()
    secret = read_secret(manifest)
    env = os.environ.copy()
    keys = [str(key) for key in manifest.get("envKeys", [])]
    missing = [key for key in keys if not env.get(key) and not secret.get(key)]
    if missing:
        fail(f"Secret is missing required key(s): {', '.join(missing)}")
    for key in keys:
        env.setdefault(key, secret[key])
    real_codex = find_real_codex()
    os.execve(real_codex, [str(real_codex), *args.codex_args], env)


def command_doctor(_: argparse.Namespace) -> None:
    manifest = load_manifest()
    print(f"Repo: {REPO_ROOT}")
    print(f"Manifest: {MANIFEST_PATH}")
    print(f"Codex config: {CODEX_CONFIG} ({'present' if CODEX_CONFIG.exists() else 'missing'})")

    for command in ("cx", "codex", "aws", "python3", "ruby"):
        path = command_path(command)
        print(f"{command}: {path or 'missing'}")

    real_codex = find_real_codex()
    print(f"real codex: {real_codex}")

    if CODEX_CONFIG.exists():
        config = CODEX_CONFIG.read_text()
        for name in sorted((manifest.get("mcpServers") or {}).keys()):
            status = "configured" if f"[mcp_servers.{name}]" in config else "missing"
            print(f"mcp {name}: {status}")

    for key in manifest.get("envKeys", []):
        key = str(key)
        status = "present" if os.environ.get(key) or launchctl_getenv(key) else "missing"
        print(f"env {key}: {status}")

    print_imessage_agent_status()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="cx")
    subparsers = parser.add_subparsers(dest="command", required=True)

    install = subparsers.add_parser("install", help="Install MCP server config from this repo")
    install.add_argument("servers", nargs="*", help="Optional MCP server names to install")
    install.add_argument("--bin-dir", type=path_arg, default=DEFAULT_USER_BIN)
    install.add_argument("--install-cx", action="store_true", help="Symlink cx into --bin-dir")
    install.add_argument(
        "--install-codex-wrapper",
        action="store_true",
        help="Install a codex wrapper into --bin-dir that loads automation secrets before launching Codex",
    )
    install.add_argument("--no-launch-agent", dest="launch_agent", action="store_false")
    install.add_argument("--no-bootstrap", action="store_true")
    install.add_argument(
        "--install-imessage-agent",
        action="store_true",
        help="Also install and start the optional iMessage-to-Codex LaunchAgent",
    )
    install.add_argument(
        "--allowed-handle",
        dest="allowed_handles",
        action="append",
        default=parse_env_list("IMESSAGE_CODEX_ALLOWED_HANDLES"),
        help="Allowed iMessage sender for --install-imessage-agent. Repeat for multiple senders.",
    )
    install.add_argument(
        "--prefix",
        default=os.environ.get("IMESSAGE_CODEX_PREFIX", "!codex "),
        help="Required message prefix for --install-imessage-agent.",
    )
    install.add_argument(
        "--workdir",
        type=path_arg,
        default=path_arg(os.environ.get("IMESSAGE_CODEX_WORKDIR", str(REPO_ROOT))),
        help="Workspace where iMessage-triggered Codex commands run.",
    )
    install.add_argument(
        "--poll-seconds",
        type=float,
        default=float(os.environ.get("IMESSAGE_CODEX_POLL_SECONDS", "5")),
        help="iMessage polling interval.",
    )
    install.add_argument(
        "--reply-mode",
        choices=["summary", "none"],
        default=os.environ.get("IMESSAGE_CODEX_REPLY_MODE", "summary"),
    )
    install.set_defaults(func=command_install, launch_agent=True, install_imessage_agent=False)

    exec_parser = subparsers.add_parser("exec", help="Run Codex with automation secrets loaded")
    exec_parser.add_argument("codex_args", nargs=argparse.REMAINDER)
    exec_parser.set_defaults(func=command_exec)

    doctor = subparsers.add_parser("doctor", help="Check local automation setup")
    doctor.set_defaults(func=command_doctor)

    imessage_agent = subparsers.add_parser(
        "install-imessage-agent",
        help="Install and start the iMessage-to-Codex LaunchAgent",
    )
    imessage_agent.add_argument(
        "--allowed-handle",
        dest="allowed_handles",
        action="append",
        default=parse_env_list("IMESSAGE_CODEX_ALLOWED_HANDLES"),
        help="Allowed phone number or iMessage email. Repeat for multiple senders.",
    )
    imessage_agent.add_argument(
        "--prefix",
        default=os.environ.get("IMESSAGE_CODEX_PREFIX", "!codex "),
        help="Message prefix required before Codex is invoked.",
    )
    imessage_agent.add_argument(
        "--workdir",
        type=path_arg,
        default=path_arg(os.environ.get("IMESSAGE_CODEX_WORKDIR", str(REPO_ROOT))),
        help="Workspace where Codex commands run.",
    )
    imessage_agent.add_argument(
        "--poll-seconds",
        type=float,
        default=float(os.environ.get("IMESSAGE_CODEX_POLL_SECONDS", "5")),
        help="Polling interval. Must be at least 1 second.",
    )
    imessage_agent.add_argument(
        "--reply-mode",
        choices=["summary", "none"],
        default=os.environ.get("IMESSAGE_CODEX_REPLY_MODE", "summary"),
    )
    imessage_agent.add_argument("--no-bootstrap", action="store_true")
    imessage_agent.set_defaults(func=command_install_imessage_agent)

    imessage_agent_status_parser = subparsers.add_parser(
        "imessage-agent-status",
        help="Check whether the optional iMessage-to-Codex LaunchAgent is loaded and running",
    )
    imessage_agent_status_parser.set_defaults(func=command_imessage_agent_status)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
