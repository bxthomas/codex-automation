#!/usr/bin/env python3
"""Listen for prefixed iMessages and invoke Codex automation."""

from __future__ import annotations

import argparse
import errno
import json
import os
import pty
import re
import select
import shlex
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[1]
CHAT_DB = Path.home() / "Library" / "Messages" / "chat.db"
STATE_DIR = Path.home() / "Library" / "Application Support" / "codex-automation"
STATE_PATH = STATE_DIR / "imessage-codex-agent-state.json"
DEFAULT_PREFIX = "!codex "
DEFAULT_POLL_SECONDS = 5.0
DEFAULT_MAX_PROMPT_CHARS = 2000
DEFAULT_REPLY_CHARS = 1200
DEFAULT_CODEX_GLOBAL_ARGS = ["--ask-for-approval", "never"]
DEFAULT_CODEX_EXEC_ARGS = ["--color", "never"]


def log(message: str) -> None:
    print(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {message}", flush=True)


def fail(message: str, code: int = 1) -> None:
    print(f"imessage-codex-agent: {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_handles(value: str) -> set[str]:
    return {item.strip().lower() for item in value.split(",") if item.strip()}


def connect_messages_db() -> sqlite3.Connection:
    if not CHAT_DB.exists():
        fail(f"Messages database not found at {CHAT_DB}.")
    try:
        connection = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True, timeout=5)
    except sqlite3.OperationalError:
        fail(
            "Could not open Messages database. Grant Full Disk Access to the app "
            "or shell running this LaunchAgent."
        )
    connection.row_factory = sqlite3.Row
    return connection


def load_state() -> dict[str, Any]:
    try:
        return json.loads(STATE_PATH.read_text())
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError:
        return {}


def save_state(state: dict[str, Any]) -> None:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    tmp.replace(STATE_PATH)


def latest_message_id() -> int:
    with connect_messages_db() as connection:
        row = connection.execute("SELECT COALESCE(MAX(ROWID), 0) AS max_id FROM message").fetchone()
    return int(row["max_id"])


def text_from_attributed_body(body: bytes | None) -> str:
    if not body:
        return ""

    # Newer Messages rows may store text only in an archived NSAttributedString.
    # In that archive, the string payload is usually a length-prefixed NSString.
    marker = b"NSString"
    candidates: list[str] = []
    start = 0
    while True:
        marker_index = body.find(marker, start)
        if marker_index < 0:
            break
        scan_end = min(len(body), marker_index + 80)
        for index in range(marker_index + len(marker), scan_end - 1):
            length = body[index]
            if not 0 < length <= DEFAULT_MAX_PROMPT_CHARS:
                continue
            end = index + 1 + length
            if end > len(body):
                continue
            try:
                candidate = body[index + 1 : end].decode("utf-8")
            except UnicodeDecodeError:
                continue
            candidate = candidate.strip()
            if candidate and not candidate.startswith("NS") and any(char.isalnum() for char in candidate):
                candidates.append(candidate)
        start = marker_index + len(marker)

    if candidates:
        return max(candidates, key=len)

    decoded = body.decode("utf-8", errors="ignore")
    runs = re.findall(r"[^\x00-\x1f\x7f-\x9f]{3,}", decoded)
    ignored = {"streamtyped", "NSObject", "NSString", "NSAttributedString", "NSDictionary", "NSNumber", "NSValue"}
    useful = [run.strip() for run in runs if run.strip() and run.strip() not in ignored and not run.strip().startswith("_kIM")]
    return " ".join(useful).strip()


def fetch_new_messages(after_id: int, limit: int = 50) -> list[sqlite3.Row]:
    query = """
        SELECT
          m.ROWID AS message_id,
          h.id AS handle,
          m.is_from_me AS is_from_me,
          m.text AS text,
          m.attributedBody AS attributed_body
        FROM message m
        LEFT JOIN handle h ON h.ROWID = m.handle_id
        WHERE m.ROWID > ?
          AND (m.text IS NOT NULL OR m.attributedBody IS NOT NULL)
        ORDER BY m.ROWID ASC
        LIMIT ?
    """
    with connect_messages_db() as connection:
        return connection.execute(query, [after_id, limit]).fetchall()


def send_imessage(recipient: str, message: str) -> None:
    script = r'''
on run argv
  set targetRecipient to item 1 of argv
  set bodyText to item 2 of argv

  tell application "Messages"
    set targetService to 1st service whose service type = iMessage
    set targetBuddy to buddy targetRecipient of targetService
    send bodyText to targetBuddy
  end tell
end run
'''
    completed = subprocess.run(
        ["osascript", "-", recipient, message],
        input=script,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip()
        raise RuntimeError(detail or "osascript exited non-zero")


def codex_command(prompt: str, global_args: list[str], exec_args: list[str]) -> list[str]:
    return [str(REPO_ROOT / "bin" / "cx"), "exec", *global_args, "exec", *exec_args, prompt]


def strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)


def append_output(output: bytearray, chunk: bytes) -> None:
    output.extend(chunk)
    text = strip_ansi(chunk.decode(errors="replace")).strip()
    if text:
        for line in text.splitlines():
            log(f"codex: {line}")


def run_with_pty(command: list[str], cwd: Path, timeout_seconds: int) -> subprocess.CompletedProcess[str]:
    master_fd, slave_fd = pty.openpty()
    output = bytearray()
    env = os.environ.copy()
    env.setdefault("TERM", "xterm-256color")
    env.setdefault("NO_COLOR", "1")

    process = subprocess.Popen(
        command,
        cwd=cwd,
        env=env,
        stdin=slave_fd,
        stdout=slave_fd,
        stderr=slave_fd,
        close_fds=True,
    )
    os.close(slave_fd)
    deadline = time.monotonic() + timeout_seconds

    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                process.kill()
                raise subprocess.TimeoutExpired(command, timeout_seconds, output.decode(errors="replace"))

            ready, _, _ = select.select([master_fd], [], [], min(0.2, remaining))
            if ready:
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError as exc:
                    if exc.errno != errno.EIO:
                        raise
                    chunk = b""
                if chunk:
                    append_output(output, chunk)
                elif process.poll() is not None:
                    break
            elif process.poll() is not None:
                try:
                    while True:
                        chunk = os.read(master_fd, 4096)
                        if not chunk:
                            break
                        append_output(output, chunk)
                except OSError as exc:
                    if exc.errno != errno.EIO:
                        raise
                break
    finally:
        os.close(master_fd)

    return subprocess.CompletedProcess(
        command,
        process.wait(),
        strip_ansi(output.decode(errors="replace")),
        "",
    )


def run_codex(command_text: str, handle: str, args: argparse.Namespace) -> str:
    prompt = (
        "An authorized iMessage command was received.\n\n"
        f"Sender handle: {handle}\n"
        f"Command prefix: {args.prefix!r}\n"
        f"Command text: {command_text}\n\n"
        "Carry out the request using the repo instructions. Keep any final response concise "
        "because it may be sent back by iMessage."
    )
    completed = run_with_pty(
        codex_command(prompt, args.codex_global_arg, args.codex_exec_arg),
        cwd=args.workdir,
        timeout_seconds=args.codex_timeout_seconds,
    )
    output = "\n".join(part.strip() for part in (completed.stdout, completed.stderr) if part.strip())
    if completed.returncode != 0:
        raise RuntimeError(output or f"Codex exited with status {completed.returncode}")
    return output.strip() or "Codex command completed."


def maybe_reply(handle: str, text: str, args: argparse.Namespace) -> None:
    if args.reply_mode == "none":
        return
    body = text.strip()
    if len(body) > args.reply_chars:
        body = body[: args.reply_chars - 1].rstrip() + "..."
    send_imessage(handle, body)


def process_message(row: sqlite3.Row, args: argparse.Namespace) -> None:
    handle = str(row["handle"] or "")
    text = str(row["text"] or "") or text_from_attributed_body(row["attributed_body"])
    normalized_handle = handle.lower()
    allowed_handles = args.allowed_self_handles if bool(row["is_from_me"]) else args.allowed_handles
    if normalized_handle not in allowed_handles:
        return
    if not text.startswith(args.prefix):
        return

    command_text = text[len(args.prefix) :].strip()
    if not command_text:
        return
    if len(command_text) > args.max_prompt_chars:
        command_text = command_text[: args.max_prompt_chars]

    log(f"running Codex for message_id={row['message_id']} handle={handle}")
    try:
        output = run_codex(command_text, handle, args)
        maybe_reply(handle, output, args)
    except Exception as exc:
        log(f"ERROR: command failed for message_id={row['message_id']}: {exc}")
        if args.reply_mode != "none":
            try:
                maybe_reply(handle, f"Codex command failed: {exc}", args)
            except Exception as reply_exc:
                log(f"ERROR: failed to send error reply: {reply_exc}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--allowed-handles",
        default=os.environ.get("IMESSAGE_CODEX_ALLOWED_HANDLES", ""),
        help="Comma-separated inbound iMessage handles allowed to invoke Codex.",
    )
    parser.add_argument(
        "--allowed-self-handles",
        default=os.environ.get("IMESSAGE_CODEX_ALLOWED_SELF_HANDLES", ""),
        help="Comma-separated self-sent iMessage handles allowed to invoke Codex.",
    )
    parser.add_argument("--prefix", default=os.environ.get("IMESSAGE_CODEX_PREFIX", DEFAULT_PREFIX))
    parser.add_argument(
        "--poll-seconds",
        type=float,
        default=float(os.environ.get("IMESSAGE_CODEX_POLL_SECONDS", DEFAULT_POLL_SECONDS)),
    )
    parser.add_argument(
        "--workdir",
        type=Path,
        default=Path(os.environ.get("IMESSAGE_CODEX_WORKDIR", REPO_ROOT)),
    )
    parser.add_argument(
        "--reply-mode",
        choices=["summary", "none"],
        default=os.environ.get("IMESSAGE_CODEX_REPLY_MODE", "summary"),
    )
    parser.add_argument(
        "--reply-chars",
        type=int,
        default=int(os.environ.get("IMESSAGE_CODEX_REPLY_CHARS", DEFAULT_REPLY_CHARS)),
    )
    parser.add_argument(
        "--max-prompt-chars",
        type=int,
        default=int(os.environ.get("IMESSAGE_CODEX_MAX_PROMPT_CHARS", DEFAULT_MAX_PROMPT_CHARS)),
    )
    parser.add_argument(
        "--codex-timeout-seconds",
        type=int,
        default=int(os.environ.get("IMESSAGE_CODEX_TIMEOUT_SECONDS", "900")),
    )
    parser.add_argument(
        "--codex-global-arg",
        action="append",
        default=shlex.split(os.environ.get("IMESSAGE_CODEX_GLOBAL_ARGS", ""))
        or DEFAULT_CODEX_GLOBAL_ARGS,
        help="Extra argument passed to Codex before the exec subcommand. Repeat as needed.",
    )
    parser.add_argument(
        "--codex-exec-arg",
        action="append",
        default=shlex.split(os.environ.get("IMESSAGE_CODEX_EXEC_ARGS", "")) or DEFAULT_CODEX_EXEC_ARGS,
        help="Extra argument passed to codex exec before the prompt. Repeat as needed.",
    )
    parser.add_argument(
        "--replay-existing",
        action="store_true",
        default=os.environ.get("IMESSAGE_CODEX_REPLAY_EXISTING", "").lower() in {"1", "true", "yes"},
        help="Process existing matching messages instead of starting after the current newest row.",
    )
    parser.add_argument("--once", action="store_true", help="Poll once and exit.")
    return parser


def main() -> None:
    args = build_parser().parse_args()
    args.allowed_handles = parse_handles(args.allowed_handles)
    args.allowed_self_handles = parse_handles(args.allowed_self_handles)
    if not args.allowed_handles and not args.allowed_self_handles:
        fail(
            "Configure at least one inbound or self handle with "
            "IMESSAGE_CODEX_ALLOWED_HANDLES or IMESSAGE_CODEX_ALLOWED_SELF_HANDLES."
        )
    if args.poll_seconds < 1:
        fail("--poll-seconds must be at least 1.")

    state = load_state()
    if args.replay_existing:
        last_seen = int(state.get("last_seen_message_id", 0))
    else:
        last_seen = int(state.get("last_seen_message_id") or latest_message_id())
        save_state({"last_seen_message_id": last_seen})

    log(
        "started; "
        f"handles={','.join(sorted(args.allowed_handles))} "
        f"self_handles={','.join(sorted(args.allowed_self_handles))} "
        f"prefix={args.prefix!r} poll={args.poll_seconds}s"
    )

    while True:
        rows = fetch_new_messages(last_seen)
        for row in rows:
            last_seen = max(last_seen, int(row["message_id"]))
            save_state({"last_seen_message_id": last_seen})
            process_message(row, args)
        if args.once:
            return
        if not rows:
            save_state({"last_seen_message_id": last_seen})
        time.sleep(args.poll_seconds)


if __name__ == "__main__":
    main()
