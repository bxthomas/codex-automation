#!/usr/bin/env python3
"""Run Codex with automation secrets loaded from AWS Secrets Manager."""

from __future__ import annotations

import json
import os
import subprocess
import sys


SECRET_NAME = "automation"
ENV_KEYS = ("HOME_ASSISTANT_TOKEN",)


def read_secret() -> dict[str, str]:
    command = [
        "aws",
        "secretsmanager",
        "get-secret-value",
        "--secret-id",
        SECRET_NAME,
        "--query",
        "SecretString",
        "--output",
        "text",
    ]
    try:
        completed = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except FileNotFoundError:
        print("aws CLI not found; cannot read automation secrets.", file=sys.stderr)
        sys.exit(127)
    except subprocess.TimeoutExpired:
        print("Timed out reading automation secrets from AWS Secrets Manager.", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        print("Failed to read AWS Secrets Manager secret 'automation'.", file=sys.stderr)
        if detail:
            print(detail, file=sys.stderr)
        sys.exit(exc.returncode or 1)

    try:
        parsed = json.loads(completed.stdout)
    except json.JSONDecodeError:
        print("Secret 'automation' must be a JSON object for codex-automation.", file=sys.stderr)
        sys.exit(1)

    if not isinstance(parsed, dict):
        print("Secret 'automation' must be a JSON object for codex-automation.", file=sys.stderr)
        sys.exit(1)

    return {key: value for key, value in parsed.items() if isinstance(value, str)}


def main() -> None:
    secret = read_secret()
    env = os.environ.copy()
    missing = [key for key in ENV_KEYS if not env.get(key) and not secret.get(key)]
    if missing:
        print(
            f"Secret 'automation' is missing required key(s): {', '.join(missing)}",
            file=sys.stderr,
        )
        sys.exit(1)

    for key in ENV_KEYS:
        env.setdefault(key, secret[key])

    os.execvpe("codex", ["codex", *sys.argv[1:]], env)


if __name__ == "__main__":
    main()
